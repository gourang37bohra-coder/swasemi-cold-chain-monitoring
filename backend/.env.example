# Application Configuration
APP_NAME="Cold-Chain Monitoring Platform"
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database Configuration (PostgreSQL with psycopg v3 driver)
DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@localhost:5432/DATABASE_NAME

# Redis Configuration (Pub/Sub and real-time event bus)
REDIS_URL=redis://localhost:6379/0

# JWT Authentication (change JWT_SECRET_KEY to a secure random value in production)
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# MQTT Ingestion Configuration
MQTT_BROKER_HOST=broker.emqx.io
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_TOPIC_PREFIX=coldchain/trackers
MQTT_CLIENT_ID=

# SMTP Alert Email Configuration
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=alerts@swasemi.com
SMTP_TLS=false
ALERT_EMAIL_TO=ops-team@apexpharma.com
EMAIL_ENABLED=true
